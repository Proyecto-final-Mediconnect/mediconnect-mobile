{
  "expo": {
    "name": "MediConnect",
    "slug": "mediconnect-mobile",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "mediconnect",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.mediconnect.app"
    },
    "android": {
      "package": "ar.mediconnect.app"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "447d197b-7e79-456c-9db8-fef1757b4afd"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "MediConnect usa la cámara para sacar fotos de tus estudios y documentos médicos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0e7c7b"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MediConnect usa la cámara para sacar fotos de tus estudios y documentos médicos.",
          "photosPermission": "MediConnect abre tus fotos para que elijas un estudio y lo sumes a tus documentos.",
          "microphonePermission": false
        }
      ],
      "@sentry/react-native"
    ],
    "owner": "mediconnecttesis"
  }
}
