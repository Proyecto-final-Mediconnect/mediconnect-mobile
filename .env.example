# Variables de entorno del cliente mobile (Expo).
# 3.4.11: los secretos reales NUNCA se commitean. Este archivo documenta
# la lista de variables necesarias SIN valores. Copialo a `.env` localmente.
#
# Convención Expo: solo las variables con prefijo EXPO_PUBLIC_ se exponen al
# bundle JS del cliente. NO pongas secretos de servidor acá.

# URL base de la API REST del backend (NestJS).
EXPO_PUBLIC_API_URL=

# URL de la web. La app abre ahí los textos legales (`/legales`, ENG-140).
# Sin valor usa la web publicada en Render.
EXPO_PUBLIC_WEB_URL=

# Entorno lógico de la app: development | staging | production.
EXPO_PUBLIC_ENV=

# DSN del proyecto mobile en Sentry (ENG-99). No es un secreto: es público por
# diseño y solo permite enviar eventos. Vacío = Sentry no se inicializa, que es
# lo esperado en local y en CI.
EXPO_PUBLIC_SENTRY_DSN=

# --- Solo para builds/CI con EAS (no se exponen al cliente) ---
# Token de acceso de Expo para EAS Build en CI (se inyecta como secret en CI).
# EXPO_TOKEN=

# Subida de source maps a Sentry en los builds `preview` y `production` (ENG-99).
# Se cargan como variables de EAS (`eas env:create`), con el token como secreto.
# NUNCA con prefijo EXPO_PUBLIC_: el token terminaría dentro del APK.
# En el perfil `development` la subida está apagada en eas.json
# (SENTRY_DISABLE_AUTO_UPLOAD): ahí el JS lo sirve Metro y no hay qué subir.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
